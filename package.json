{
  "name": "tbl-md",
  "version": "0.4.1",
  "description": "A readable table format for Markdown: key-based tables in a fenced tbl block, with lossless conversion to and from GFM tables",
  "license": "MIT",
  "author": "Thomas Kalka",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thoka/tbl-md.git"
  },
  "homepage": "https://github.com/thoka/tbl-md#readme",
  "bugs": {
    "url": "https://github.com/thoka/tbl-md/issues"
  },
  "keywords": [
    "markdown",
    "table",
    "gfm",
    "tbl",
    "lint"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./markdown-it": {
      "types": "./dist/markdown-it.d.ts",
      "import": "./dist/markdown-it.js"
    },
    "./markdown-it.iife.js": "./dist/tbl-md-markdown-it.iife.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "tbl-md": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/format.md",
    "docs/api.md",
    "docs/cli.md",
    "docs/markdown-it.md",
    "docs/known-gaps.md",
    "schema/tbl-md.schema.json",
    "skills/tbl-md/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/bundle.ts",
    "prepack": "npm run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22",
    "esbuild": "0.25.12",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "markdown-it": "15.0.1"
  }
}
