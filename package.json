{
  "name": "tbl-md",
  "version": "0.2.0",
  "description": "A readable table format for Markdown: key-based tables in a fenced tbl block, with lossless conversion to and from GFM tables",
  "license": "MIT",
  "author": "Thomas Kalka",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thoka/tbl-md.git"
  },
  "homepage": "https://github.com/thoka/tbl-md#readme",
  "bugs": {
    "url": "https://github.com/thoka/tbl-md/issues"
  },
  "keywords": [
    "markdown",
    "table",
    "gfm",
    "tbl",
    "lint"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tbl-md": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/format.md",
    "schema/tbl-md.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "markdown-it": "15.0.1"
  }
}
